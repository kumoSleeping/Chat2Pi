{
  "name": "chat2pi-ws-probe",
  "main": "src.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": false,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "ProbeRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProbeRoom"],
    },
  ],
  "vars": {
    "PROBE_ENABLED": "false",
  },
}
