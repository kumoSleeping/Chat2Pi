{
  "name": "chat2pi",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "DeviceRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" },
  ],
  "vars": { "PUBLIC_URL": "https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev" },
}
