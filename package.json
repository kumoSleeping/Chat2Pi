{
  "name": "chat2pi",
  "version": "0.4.0",
  "description": "Self-hosted ChatGPT access to local Pi tools with account and device isolation",
  "type": "module",
  "bin": {
    "chat2pi": "build/cli.js"
  },
  "files": [
    "build",
    "examples",
    "README.md",
    "docs",
    "cloud/*.ts",
    "cloud/catalog.json",
    "cloud/package.json",
    "cloud/package-lock.json",
    "cloud/wrangler.example.jsonc",
    "ts/manifest.ts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests-ts/*.test.ts",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test:cloud": "npm --prefix cloud test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.0.0",
    "express": "^5.0.0",
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumoSleeping/Chat2Pi.git"
  }
}
